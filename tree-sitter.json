{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "css",
      "camelcase": "CSS",
      "scope": "source.css",
      "path": ".",
      "file-types": ["css"],
      "injection-regex": "^css$"
    }
  ],
  "metadata": {
    "version": "0.23.2",
    "license": "MIT",
    "description": "CSS grammar for tree-sitter",
    "authors": [
      {
        "name": "WillBooster Inc."
      }
    ],
    "links": {
      "repository": "https://github.com/WillBooster/tree-sitter-css"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
